     dirpath = Nametab.dirpath_of_global gr;
     local = (match gr with GlobRef.ConstRef c -> Declare.is_local_constant c | _ -> false) }
 
+
+(* SPIKE (triage aid, not shipped): is an alternative's module imported at
+   this use site? Proxy: a sibling in the same module whose basename nothing
+   else shares resolves as a bare name iff that module is imported. *)
+let triage_on = Sys.getenv_opt "NA_TRIAGE" <> None
+let siblings : (DirPath.t, GlobRef.t list) Hashtbl.t option ref = ref None
+let build_siblings () =
+  let tbl = Hashtbl.create 4096 in
+  let add gr =
+    match Nametab.path_of_global gr with
+    | exception Not_found -> ()
+    | p ->
+      let dp = fst (Libnames.repr_path p) in
+      Hashtbl.replace tbl dp (gr :: (try Hashtbl.find tbl dp with Not_found -> []))
+  in
+  let env = Global.env () in
+  Environ.fold_constants (fun c _ () -> add (GlobRef.ConstRef c)) env ();
+  Environ.fold_inductives (fun m _ () -> add (GlobRef.IndRef (m, 0))) env ();
+  siblings := Some tbl;
+  tbl
+let siblings_of dp =
+  let tbl = match !siblings with Some t -> t | None -> build_siblings () in
+  match Hashtbl.find_opt tbl dp with
+  | Some l -> l
+  | None -> (match Hashtbl.find_opt (build_siblings ()) dp with Some l -> l | None -> [])
+let import_status alt =
+  let dp = fst (Libnames.repr_path (Nametab.path_of_global alt)) in
+  (* Test every sibling whose basename is unique right now: all resolving
+     means the module is imported; none, not imported; a mix means a
+     filtered import (e.g. `Export String (string(..))`), where this proxy
+     can't say anything about [alt] itself. *)
+  let verdicts =
+    List.filter_map
+      (fun d ->
+        let local = match d with GlobRef.ConstRef c -> Declare.is_local_constant c | _ -> false in
+        if GlobRef.UserOrd.equal d alt || local then None
+        else
+          let q = Libnames.qualid_of_ident (Nametab.basename_of_global d) in
+          match Nametab.locate_all q with
+          | [ only ] when GlobRef.UserOrd.equal only d ->
+            Some (match Nametab.locate q with exception Not_found -> false | w -> GlobRef.UserOrd.equal w d)
+          | _ -> None)
+      (siblings_of dp)
+  in
+  let n = List.length verdicts and yes = List.length (List.filter Fun.id verdicts) in
+  if n = 0 then ("unknown", "0")
+  else if yes = n then ("shadowed", string_of_int n)
+  else if yes = 0 then ("latent", string_of_int n)
+  else ("filtered", Printf.sprintf "%d/%d" yes n)
+
+let triage_emit (loc : Loc.t) written winner others =
+  if triage_on then
+    let file = match loc.Loc.fname with Loc.InFile { file; _ } -> file | _ -> "?" in
+    List.iter
+      (fun alt ->
+        let status, sib = import_status alt in
+        let local = match alt with GlobRef.ConstRef c -> Declare.is_local_constant c | _ -> false in
+        Printf.eprintf "TRIAGE\t%s\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n%!" file loc.Loc.line_nb written
+          (Libnames.string_of_path (Nametab.path_of_global winner))
+          (Libnames.string_of_path (Nametab.path_of_global alt)) status sib
+          (if local then "local" else "-"))
+      others
+
 let is_global = function GlobRef.VarRef _ -> false | _ -> true
 
