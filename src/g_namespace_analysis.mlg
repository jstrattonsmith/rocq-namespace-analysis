DECLARE PLUGIN "rocq-namespace-analysis.plugin"

{

open Names
open Pp
open Stdarg

let () = Glob_capture.install ()

let qualid_to_dirpath q =
  let (dp, id) = Libnames.repr_qualid q in
  Libnames.add_dirpath_suffix dp id

let run_namespace_analysis domains =
  let domains = List.map qualid_to_dirpath domains in
  if domains = [] then
    CErrors.user_err (str "NamespaceAnalysis requires at least one domain, e.g. NamespaceAnalysis MyDev.PartA.")
  else begin
    let members = Domain_scan.members_of_domains domains in
    let clashes = Clash_detect.find_clashes members in
    let used = Glob_capture.occurrences () in
    let report = Report.make ~member_count:(List.length members) ~clashes ~used in
    Feedback.msg_notice (Report.to_pp report)
  end

}

VERNAC COMMAND EXTEND NamespaceAnalysisHello CLASSIFIED AS QUERY
| [ "NamespaceAnalysis" "Hello" ] ->
  { Feedback.msg_notice (Pp.str "NamespaceAnalysis plugin loaded.") }
END

VERNAC COMMAND EXTEND NamespaceAnalysisRun CLASSIFIED AS QUERY
| [ "NamespaceAnalysis" ne_reference_list(domains) ] ->
  { run_namespace_analysis domains }
END
